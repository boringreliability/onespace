# Every variable server/config.ts reads. Copy to .env and fill in; never commit .env.
# Run the server with it:  node --env-file=.env dist-server/index.mjs

# Postgres. Local: `docker compose up -d db` gives this one.
DATABASE_URL=postgres://onespace:onespace@127.0.0.1:5432/onespace

# The origin the browser loads the game from — exactly, no path, no trailing slash.
# Local development: the Vite dev server's origin (vite.config.ts: 127.0.0.1:5173).
# Every write must carry this Origin (CSRF), and the Discord redirect is
# <PUBLIC_ORIGIN>/api/auth/discord/callback.
PUBLIC_ORIGIN=http://127.0.0.1:5173

# The Discord application (OAuth2) and the guild role that grants access.
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_GUILD_ID=your-guild-id
DISCORD_ROLE_ID=your-role-id

# Optional. Default 8790 (the port Vite proxies /api to).
PORT=8790

# Optional. `production` on the deployed host (HSTS, X-Forwarded-For); leave unset locally.
NODE_ENV=

# Optional, tests only: `1` opens POST /api/test/login (no Discord). Refused in
# production and unless PUBLIC_ORIGIN is a localhost origin.
ONESPACE_TEST_LOGIN=
